# ---- Cargo ----------------------------------------------------------------
# The build tree. Everything under it is reproducible from the sources.
/target/
**/*.rs.bk

# ---- Vendored librespot ----------------------------------------------------
# A separate upstream clone with its own history, not part of this workspace.
# Restore it with:
#   git clone https://github.com/librespot-org/librespot vendor/librespot
#   git -C vendor/librespot checkout <pinned-rev>
/vendor/librespot/

# ---- Reverse engineering scratch ------------------------------------------
# The extracted Store build (xpui.spa, login.spa, Spotify.dll) and the
# per-run analysis output. Both are regenerated by the scripts in re/.
/re/target/
/re/out/*
/re/__pycache__/
*.pyc

# Curated results that the spec (re/ENGINE-SPEC.md) refers to by name.
# They are small and are the distilled output of the analysis, so they stay
# in the tree.
!/re/out/api-surface.txt
!/re/out/route-map.txt
!/re/out/esperanto-schema.json

# ---- Credentials ----------------------------------------------------------
# Never commit OAuth material or a registered app's secret.
tokens.json
*.env
.env
.env.*

# ---- Editor and OS noise --------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
